{
  "name": "manga-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lector de manga local para Windows y Linux",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.5.438",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.local.mangadesktop",
    "productName": "Manga Desktop",
    "files": [
      "desktop/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/yauzl/**/*",
      "node_modules/pend/**/*",
      "node_modules/node-unrar-js/**/*",
      "node_modules/pdfjs-dist/build/**/*"
    ],
    "asarUnpack": [
      "desktop/wallpaper.ps1",
      "desktop/mouse-forward.ps1"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "desktop/icon.png"
    }
  }
}
